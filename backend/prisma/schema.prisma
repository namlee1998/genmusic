// Prisma schema for AIDLC Backend
// This file sets up SQLite to replace Supabase PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ============================================
// Core Tables
// ============================================

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String   // Added for local auth
  role      String   @default("user")
  createdAt DateTime @default(now())
  
  projects  ProjectMembership[]
  tasks     Task[]
}

model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  fullName     String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Profile {
  userId     String   @id
  fullName   String?
  age        Int?
  jobTitle   String?
  address    String?
  phone      String?
  bio        String?
  avatarUrl  String?
  avatarPath String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  members     ProjectMembership[]
  tasks       Task[]
}

model ProjectMembership {
  id        String   @id @default(uuid())
  userId    String
  projectId String
  role      String   @default("member")
  invitedBy String?
  joinedAt  DateTime?
  
  user      User     @relation(fields: [userId], references: [id])
  project   Project  @relation(fields: [projectId], references: [id])
}

model ProjectInvitation {
  id        String   @id @default(uuid())
  projectId String
  email     String
  role      String   @default("member")
  token     String   @unique
  status    String   @default("pending")
  invitedBy String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ============================================
// SDLC Pipeline Tables
// ============================================

model Task {
  id                String   @id @default(uuid())
  projectId         String
  type              String   // "extract-flows", "generate-testcases", etc.
  status            String   @default("pending")
  promptProfile     String?
  result            String?  // JSON string
  error             String?
  inputContentHash  String?
  outputContentHash String?
  sourceRunId       String?
  versionStatus     String   @default("committed")
  observability     String?  // JSON string
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  userId            String?
  user              User?    @relation(fields: [userId], references: [id])
  project           Project  @relation(fields: [projectId], references: [id])
  artifacts         AgentArtifact[]
}

model AgentArtifact {
  id               String   @id @default(uuid())
  taskId           String
  projectId        String?
  agentType        String?
  artifactType     String
  artifactKey      String?
  title            String?
  contentJson      String?  // JSON string
  contentText      String?  // Text
  ordinal          Int      @default(0)
  sourceArtifactId String?
  contentHash      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  task             Task     @relation(fields: [taskId], references: [id])
}

model Document {
  id        String   @id @default(uuid())
  projectId String
  fileName  String
  fileType  String
  filePath  String
  fileSize  Int
  folderId  String?
  status    String   @default("uploaded")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Folder {
  id        String   @id @default(uuid())
  projectId String
  parentId  String?
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Testcase {
  id             String   @id @default(uuid())
  taskId         String
  projectId      String
  featureName    String
  flowName       String
  scenarioData   String?  // JSON string
  automationYaml String?
  yamlFilename   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SessionState {
  id             String   @id @default(uuid())
  page           String
  userId         String
  projectId      String?
  selectedDocIds String?  // JSON string
  taskId         String?
  metadata       String?  // JSON string
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model HitlDecision {
  id            String   @id @default(uuid())
  workflowRunId String?
  taskId        String
  projectId     String?
  gate          String?
  decision      String   // "approve", "reject"
  comment       String?
  reviewerId    String?
  createdAt     DateTime @default(now())
}

model FeatureBacklog {
  id            String   @id @default(uuid())
  projectId     String
  taskId        String?
  title         String
  description   String?
  priority      String   @default("medium")
  status        String   @default("draft")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Plan {
  id                   String   @id @default(uuid())
  name                 String
  creditsLimit         Int      @default(0)
  maxProjects          Int?
  maxMembersPerProject Int?
  taskHistoryDays      Int?
  description          String?
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
}

model UserSubscription {
  id            String   @id @default(uuid())
  userId        String
  planId        String
  status        String   @default("active")
  creditsUsed   Int      @default(0)
  creditsTotal  Int      @default(0)
  periodStart   DateTime?
  periodEnd     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model UsageLog {
  id            String   @id @default(uuid())
  userId        String?
  projectId     String?
  taskId        String?
  agentType     String
  status        String
  tokenInput    Int      @default(0)
  tokenOutput   Int      @default(0)
  tokenTotal    Int      @default(0)
  creditsCharged Float   @default(0)
  executedAt    DateTime @default(now())
}

model AuditLog {
  id            String   @id @default(uuid())
  userId        String?
  action        String
  entityType    String?
  entityId      String?
  details       String?  // JSON string
  createdAt     DateTime @default(now())
}

model DashboardSnapshot {
  id            String   @id @default(uuid())
  date          DateTime @unique
  metrics       String   // JSON string
  createdAt     DateTime @default(now())
}

