// AIFA persistence map.
//
// Beginner reading guide:
// - Start with Task, AgentEvent, AgentArtifact, HitlDecision, and PendingGate.
// - Task stores one worker run; AgentEvent stores its ordered lifecycle history.
// - Artifact content may live on disk while this database stores its metadata.
// - SQLite is the active local/runtime database; DATABASE_URL isolates dev/tests.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // Env-driven so tests/CI/smoke can target an isolated sqlite file and
  // never touch dev.db. Local dev sets DATABASE_URL="file:./dev.db" in .env.
  url      = env("DATABASE_URL")
}

// ============================================
// Core Tables
// ============================================

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String   // Added for local auth
  role      String   @default("user")
  createdAt DateTime @default(now())
  
  projects  ProjectMembership[]
  tasks     Task[]
}

model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  fullName     String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Profile {
  userId     String   @id
  fullName   String?
  age        Int?
  jobTitle   String?
  address    String?
  phone      String?
  bio        String?
  avatarUrl  String?
  avatarPath String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  members     ProjectMembership[]
  tasks       Task[]
}

model ProjectMembership {
  id        String   @id @default(uuid())
  userId    String
  projectId String
  role      String   @default("member")
  invitedBy String?
  joinedAt  DateTime?
  
  user      User     @relation(fields: [userId], references: [id])
  project   Project  @relation(fields: [projectId], references: [id])
}

model ProjectInvitation {
  id        String   @id @default(uuid())
  projectId String
  email     String
  role      String   @default("member")
  token     String   @unique
  status    String   @default("pending")
  invitedBy String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ============================================
// SDLC Pipeline Tables
// ============================================

model Task {
  id                String   @id @default(uuid())
  projectId         String
  type              String   // "extract-flows", "generate-testcases", etc.
  status            String   @default("pending")
  promptProfile     String?
  result            String?  // JSON string
  error             String?
  inputContentHash  String?
  outputContentHash String?
  sourceRunId       String?
  versionStatus     String   @default("committed")
  observability     String?  // JSON string
  // Structured HITL (plan 2.4 / 2.7 / 2.8): a Task is one step's state.
  agentOutput       String?  // JSON string — raw output the agent produced
  approvedOutput    String?  // JSON string — human-approved/edited output (next agent input)
  outputVersion     Int      @default(0) // optimistic lock, bumped on each edit
  retryCount        Int      @default(0)
  lastRetryReason   String?
  gateMode          String?  // strict_manual | confidence_based | auto_approve_safe
  executionStatus   String   @default("queued")
  attempt           Int      @default(0)
  maxAttempts       Int      @default(1)
  lockedBy          String?
  lockedAt          DateTime?
  heartbeatAt       DateTime?
  startedAt         DateTime?
  finishedAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  userId            String?
  user              User?    @relation(fields: [userId], references: [id])
  project           Project  @relation(fields: [projectId], references: [id])
  artifacts         AgentArtifact[]
  events            AgentEvent[]
}

model AgentEvent {
  id         String   @id @default(uuid())
  taskId     String
  projectId  String
  sequence   Int
  type       String
  actor      String
  payload    String?
  createdAt  DateTime @default(now())

  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, sequence])
  @@index([projectId, createdAt])
  @@index([taskId, createdAt])
}

model AgentArtifact {
  id               String   @id @default(uuid())
  taskId           String
  projectId        String?
  agentType        String?
  artifactType     String
  artifactKey      String?
  title            String?
  // Validation status (T1): VALID | INVALID | PENDING. Default VALID keeps
  // pre-existing rows non-breaking; new rows are set explicitly after the
  // role validator (_validateGateOutput) runs.
  status           String   @default("VALID")
  contentJson      String?  // JSON string
  contentText      String?  // Text
  ordinal          Int      @default(0)
  sourceArtifactId String?
  contentHash      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  task             Task     @relation(fields: [taskId], references: [id])
}

model Document {
  id        String   @id @default(uuid())
  projectId String
  fileName  String
  fileType  String
  filePath  String
  fileSize  Int
  folderId  String?
  status    String   @default("uploaded")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Folder {
  id        String   @id @default(uuid())
  projectId String
  parentId  String?
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Testcase {
  id             String   @id @default(uuid())
  taskId         String
  projectId      String
  featureName    String
  flowName       String
  scenarioData   String?  // JSON string
  automationYaml String?
  yamlFilename   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SessionState {
  id             String   @id @default(uuid())
  page           String
  userId         String
  projectId      String?
  selectedDocIds String?  // JSON string
  taskId         String?
  metadata       String?  // JSON string
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model HitlDecision {
  id            String   @id @default(uuid())
  workflowRunId String?
  taskId        String
  projectId     String?
  gate          String?
  decision      String   // "approve", "reject"
  comment       String?
  reviewerId    String?
  // Structured HITL + append-only audit (plan 2.3.3 / 2.8 / 3).
  decisionId        String?  @unique // idempotency key — duplicate is ignored
  action            String?  // approve | reject | edit_approve | escalation_required
  baseOutputVersion Int?     // optimistic lock the decision was made against
  retryReason       String?  // schema_invalid | ac_not_measurable | coverage_gap | build_fail | quality_low | other
  jsonPatch         String?  // JSON string — RFC 6902 operations (for edit_approve)
  payload           String?  // JSON string — extra context (rerun input/output, etc.)
  createdAt     DateTime @default(now())
}

model PendingGate {
  approvalId String   @id
  taskId     String
  projectId  String?
  role       String
  kind       String
  payload    String
  status     String   @default("pending")
  resolution String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  resolvedAt DateTime?

  @@index([taskId])
  @@index([projectId])
  @@index([status])
}

model FeatureBacklog {
  id            String   @id @default(uuid())
  projectId     String
  taskId        String?
  title         String
  description   String?
  priority      String   @default("medium")
  status        String   @default("draft")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Plan {
  id                   String   @id @default(uuid())
  name                 String
  creditsLimit         Int      @default(0)
  maxProjects          Int?
  maxMembersPerProject Int?
  taskHistoryDays      Int?
  description          String?
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
}

model UserSubscription {
  id            String   @id @default(uuid())
  userId        String   @unique
  planId        String
  status        String   @default("active")
  creditsUsed   Int      @default(0)
  creditsTotal  Int      @default(0)
  periodStart   DateTime?
  periodEnd     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model UsageLog {
  id            String   @id @default(uuid())
  userId        String?
  projectId     String?
  taskId        String?
  agentType     String
  status        String
  tokenInput    Int      @default(0)
  tokenOutput   Int      @default(0)
  tokenTotal    Int      @default(0)
  creditsCharged Float   @default(0)
  executedAt    DateTime @default(now())
}

model AuditLog {
  id            String   @id @default(uuid())
  userId        String?
  action        String
  entityType    String?
  entityId      String?
  details       String?  // JSON string
  createdAt     DateTime @default(now())
}

model DashboardSnapshot {
  id            String   @id @default(uuid())
  date          DateTime @unique
  metrics       String   // JSON string
  createdAt     DateTime @default(now())
}

