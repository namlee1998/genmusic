# Server
PORT=3000
NODE_ENV=development

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-project-publishable-key
SUPABASE_SECRET_KEY=sb_secret_your-project-secret-key
SUPABASE_STORAGE_BUCKET=documents
SUPABASE_AVATAR_BUCKET=avatars

# Auth redirect after OAuth/email actions.
# Local example: http://localhost:5173/auth
# Production example: https://your-frontend.vercel.app/auth
SUPABASE_AUTH_REDIRECT_URL=http://localhost:5173/auth

# AI Agents
AGENTS_BASE_URL=http://127.0.0.1:8001

# Frontend URL (for CORS)
# Example: https://your-frontend.vercel.app
# Multiple origins are supported via comma-separated values.
FRONTEND_URL=http://localhost:5173

# Upload limits (bytes)
MAX_FILE_SIZE=10485760
USE_MOCK_AGENTS=true
ENABLE_LEGACY_WORKFLOWS=false

# AIFA v3 execution path (local Claude Code CLI demo)
# EXECUTION_PATH selects which worker produces agent output:
#   langchain   = existing LangChain/mock path
#   claude-code = repo-aware local Claude Code CLI runner
EXECUTION_PATH=claude-code
# Local Claude Code CLI runner. It uses your local Claude Code login.
# On Windows prefer claude.cmd to avoid PowerShell execution-policy issues.
CLAUDE_CODE_COMMAND=claude.cmd
CLAUDE_CODE_OUTPUT_FORMAT=json
CLAUDE_CODE_PERMISSION_MODE=default
CLAUDE_CODE_TIMEOUT_MS=600000
CLAUDE_CODE_LENIENT_CONTRACT=true
# Local-only escape hatch for corporate/self-signed certificate issues.
# Keep false unless you are deliberately debugging local Claude Code connectivity.
CLAUDE_CODE_INSECURE_TLS=false

# Max concurrent SDLC workflows; a 4th run while 3 are active returns 429.
MAX_PARALLEL_WORKFLOWS=3
# Gate watchdog timeout (ms); an unanswered approval auto-rejects after this.
GATE_TIMEOUT_MS=600000

# Local JWT auth. Replace these defaults outside local development.
JWT_SECRET=replace-for-shared-environments
JWT_EXPIRES_IN=7d
ADMIN_JWT_SECRET=replace-for-shared-environments
ADMIN_JWT_EXPIRES_IN=8h
